{
  "$schema": "http://json.schemastore.org/template",
  "author": "Frostdev",
  "classifications": ["Kiln", "Enshrouded", "Mod", "Web Admin"],
  "identity": "Kilnwarden.Module.Template",
  "name": "Kilnwarden module (a Kiln mod that adds a page to the web panel)",
  "shortName": "kilnwarden-module",
  "tags": { "language": "C#", "type": "project" },
  "sourceName": "MyPanelMod",
  "preferNameDirectory": true,
  "symbols": {
    "moduleId": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "mymodule",
      "replaces": "mymodule",
      "description": "The module id in the panel: lower-case letters, digits, - and _ (its routes are /api/<id>/...)."
    },
    "modId": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "my-panel-mod",
      "replaces": "my-panel-mod",
      "description": "The Kiln mod id (kiln.mod.json id)."
    }
  }
}
