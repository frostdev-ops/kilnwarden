<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- this repo's own package folder: NuGet never refreshes a version it has cached, and Kiln's dev builds can reuse a
         version number -->
    <add key="globalPackagesFolder" value=".nuget-packages" />
  </config>
  <packageSources>
    <!-- kiln-sdk: a link to the sdk/ folder of the Kiln release global.json names (tools/link-sdk.sh makes it) -->
    <add key="kiln-sdk" value="kiln-sdk" />
  </packageSources>
</configuration>
